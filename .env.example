# Passwords live in ./secrets/, never here.
COMPOSE_PROJECT_NAME=odoo19

# Must match the host account owning ./odoo, ./addons and ./secrets (id -u / id -g).
# Changing these requires `docker compose up -d --build`.
UID=1000
GID=1000

POSTGRES_USER=odoo
POSTGRES_DB=odoo19-demo

ODOO_PORT=8069
ODOO_WS_PORT=8072

PGADMIN_PORT=5050
PGADMIN_EMAIL=odoo@example.com
